  "body.interplanetary.ariel": "Ariel",
  "body.interplanetary.ariel.desc": "The brightest of Uranus' moons, split by deep rift valleys.",
  "body.interplanetary.bennu": "Bennu",
  "body.interplanetary.bennu.desc": "A rubble-pile asteroid: a field of drifting boulders and carbon-rich rock above an endless void.",
  "body.interplanetary.callisto": "Callisto",
  "body.interplanetary.callisto.desc": "The most heavily cratered body known: dark, ancient and frozen, with ice in its craters.",
  "body.interplanetary.ceres": "Ceres",
  "body.interplanetary.ceres.desc": "The largest object in the asteroid belt, a dwarf planet with glowing salt deposits in its craters.",
  "body.interplanetary.charon": "Charon",
  "body.interplanetary.charon.desc": "Pluto's giant moon, with a vast canyon belt and a rust-red polar cap known as Mordor Macula.",
  "body.interplanetary.deimos": "Deimos",
  "body.interplanetary.deimos.desc": "Mars' tiny outer moon, smoothed by a thick blanket of dust.",
  "body.interplanetary.earth": "Earth",
  "body.interplanetary.earth.desc": "Home. Breathable air, liquid water and everything you left behind.",
  "body.interplanetary.enceladus": "Enceladus",
  "body.interplanetary.enceladus.desc": "The brightest world of all. Icy geysers erupt from its blue 'tiger stripe' fractures.",
  "body.interplanetary.eris": "Eris",
  "body.interplanetary.eris.desc": "The most massive dwarf planet, out in the dark scattered disc. Coated in gleaming methane frost.",
  "body.interplanetary.europa": "Europa",
  "body.interplanetary.europa.desc": "An ice-shelled moon hiding a dark global ocean - and glowing life beneath the ice.",
  "body.interplanetary.ganymede": "Ganymede",
  "body.interplanetary.ganymede.desc": "The largest moon in the Solar System, striped with long bright grooves of ancient ice.",
  "body.interplanetary.haumea": "Haumea",
  "body.interplanetary.haumea.desc": "A fast-spinning, egg-shaped dwarf planet of crystalline water ice. Frost crystals glitter everywhere.",
  "body.interplanetary.iapetus": "Iapetus",
  "body.interplanetary.iapetus.desc": "The two-faced moon: one hemisphere coal-black, the other snow-white, with a great mountain ridge.",
  "body.interplanetary.io": "Io",
  "body.interplanetary.io.desc": "The most volcanic world in the Solar System. Lava lakes, sulfur plains and Jupiter overhead.",
  "body.interplanetary.makemake": "Makemake",
  "body.interplanetary.makemake.desc": "A reddish dwarf planet beyond Pluto, frosted with methane and ethane ices.",
  "body.interplanetary.mars": "Mars",
  "body.interplanetary.mars.desc": "The Red Planet: rust-red dunes, giant volcanoes, deep canyons and blue sunsets.",
  "body.interplanetary.mercury": "Mercury",
  "body.interplanetary.mercury.desc": "The scorched innermost planet. The Sun looms huge in a black sky. Solar crystals grow here.",
  "body.interplanetary.mimas": "Mimas",
  "body.interplanetary.mimas.desc": "The 'Death Star' moon, scarred by one enormous crater. Saturn and its rings fill the sky.",
  "body.interplanetary.miranda": "Miranda",
  "body.interplanetary.miranda.desc": "A patchwork moon with the tallest cliffs in the Solar System: Verona Rupes.",
  "body.interplanetary.moon": "The Moon",
  "body.interplanetary.moon.desc": "Earth's companion. Grey maria, bright highlands and countless craters. Rich in titanium.",
  "body.interplanetary.oberon": "Oberon",
  "body.interplanetary.oberon.desc": "The outermost large moon of Uranus, with craters and a mountain six kilometres high.",
  "body.interplanetary.phobos": "Phobos",
  "body.interplanetary.phobos.desc": "Mars' larger moon, a lumpy grooved rock that barely holds on to you. Mars fills the sky.",
  "body.interplanetary.pluto": "Pluto",
  "body.interplanetary.pluto.desc": "The beloved dwarf planet: a heart-shaped glacier of nitrogen ice beside dark red tholin highlands.",
  "body.interplanetary.psyche": "Psyche",
  "body.interplanetary.psyche.desc": "A metal world: the exposed iron core of a shattered protoplanet. The only known source of iridium.",
  "body.interplanetary.rhea": "Rhea",
  "body.interplanetary.rhea.desc": "Saturn's second-largest moon: a quiet, cratered ball of ice and rock.",
  "body.interplanetary.titan": "Titan",
  "body.interplanetary.titan.desc": "A hazy orange world with dunes, rain and lakes - of liquid methane. Fuel for the taking.",
  "body.interplanetary.titania": "Titania",
  "body.interplanetary.titania.desc": "Uranus' largest moon, torn by enormous canyons such as Messina Chasma.",
  "body.interplanetary.triton": "Triton",
  "body.interplanetary.triton.desc": "Neptune's captured moon: pink nitrogen frost, 'cantaloupe' terrain and erupting nitrogen geysers.",
  "body.interplanetary.umbriel": "Umbriel",
  "body.interplanetary.umbriel.desc": "The darkest of Uranus' large moons, ancient and covered in craters.",
  "body.interplanetary.venus": "Venus",
  "body.interplanetary.venus.desc": "A crushing, scorching greenhouse world of lava plains under endless yellow clouds.",
  "body.interplanetary.vesta": "Vesta",
  "body.interplanetary.vesta.desc": "A battered protoplanet with a gigantic impact basin and a towering central peak. Diamonds hide inside.",
